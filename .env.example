# Vercel server configuration. The browser does not receive either value.
SUPABASE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only database access. Vercel Authentication protects every deployment.
SUPABASE_SECRET_KEY=

# Pipeline configuration
UNIVERSE_SOURCE=file
UNIVERSE_FILE=config/initial_universe.csv
CALCULATION_VERSION=v1
